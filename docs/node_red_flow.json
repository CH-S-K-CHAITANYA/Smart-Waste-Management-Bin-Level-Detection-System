[
  {
    "id": "tab_smartwaste",
    "type": "tab",
    "label": "Smart Waste Monitor",
    "disabled": false
  },
  {
    "id": "mqtt_in_telemetry",
    "type": "mqtt in",
    "z": "tab_smartwaste",
    "name": "Subscribe Telemetry",
    "topic": "smartwaste/#",
    "qos": "1",
    "datatype": "auto",
    "broker": "hivemq_broker",
    "x": 120,
    "y": 120,
    "wires": [["json_parse"]]
  },
  {
    "id": "json_parse",
    "type": "json",
    "z": "tab_smartwaste",
    "name": "Parse JSON",
    "property": "payload",
    "action": "",
    "pretty": false,
    "x": 310,
    "y": 120,
    "wires": [["func_extract", "func_alert_check"]]
  },
  {
    "id": "func_extract",
    "type": "function",
    "z": "tab_smartwaste",
    "name": "Extract Fill%",
    "func": "var fill = msg.payload.fill_percentage || 0;\nvar binId = msg.payload.bin_id || 'UNKNOWN';\nmsg.payload = fill;\nmsg.topic = binId;\nreturn msg;",
    "outputs": 1,
    "x": 500,
    "y": 80,
    "wires": [["gauge_fill", "chart_history"]]
  },
  {
    "id": "func_alert_check",
    "type": "function",
    "z": "tab_smartwaste",
    "name": "Alert Filter",
    "func": "if (msg.payload.alert === true || msg.payload.alert === 'true') {\n  msg.payload = '⚠ ' + msg.payload.bin_id + ' needs collection! Fill: ' + msg.payload.fill_percentage + '%';\n  return msg;\n}\nreturn null;",
    "outputs": 1,
    "x": 500,
    "y": 160,
    "wires": [["notification_alert"]]
  },
  {
    "id": "gauge_fill",
    "type": "ui_gauge",
    "z": "tab_smartwaste",
    "name": "Fill Level Gauge",
    "group": "grp_bins",
    "order": 1,
    "width": 4,
    "height": 4,
    "gtype": "gage",
    "title": "Bin Fill Level",
    "label": "%",
    "format": "{{value}}%",
    "min": 0,
    "max": 100,
    "colors": ["#00b500", "#e6e600", "#ca3838"],
    "seg1": 50,
    "seg2": 80,
    "x": 720,
    "y": 80,
    "wires": []
  },
  {
    "id": "chart_history",
    "type": "ui_chart",
    "z": "tab_smartwaste",
    "name": "Fill History",
    "group": "grp_history",
    "order": 2,
    "width": 12,
    "height": 6,
    "label": "Bin Fill Level Over Time",
    "chartType": "line",
    "legend": "true",
    "xformat": "HH:mm:ss",
    "interpolate": "linear",
    "nodata": "No data yet",
    "dot": false,
    "ymin": "0",
    "ymax": "100",
    "x": 720,
    "y": 140,
    "wires": []
  },
  {
    "id": "notification_alert",
    "type": "ui_notification",
    "z": "tab_smartwaste",
    "name": "Alert Notification",
    "group": "grp_alerts",
    "order": 3,
    "width": 6,
    "height": 2,
    "border": true,
    "raw": false,
    "x": 720,
    "y": 200,
    "wires": []
  },
  {
    "id": "hivemq_broker",
    "type": "mqtt-broker",
    "name": "HiveMQ Public",
    "broker": "broker.hivemq.com",
    "port": "1883",
    "clientid": "NodeRED-SmartWaste-001",
    "usetls": false,
    "compatmode": false,
    "keepalive": "60",
    "cleansession": true,
    "birthTopic": "",
    "birthQos": "0",
    "birthPayload": "",
    "closeTopic": "",
    "closeQos": "0",
    "closePayload": "",
    "willTopic": "",
    "willQos": "0",
    "willPayload": ""
  },
  {
    "id": "grp_bins",
    "type": "ui_group",
    "name": "Bin Status",
    "tab": "ui_tab_waste",
    "order": 1,
    "disp": true,
    "width": "12"
  },
  {
    "id": "grp_history",
    "type": "ui_group",
    "name": "Fill History",
    "tab": "ui_tab_waste",
    "order": 2,
    "disp": true,
    "width": "12"
  },
  {
    "id": "grp_alerts",
    "type": "ui_group",
    "name": "Alerts",
    "tab": "ui_tab_waste",
    "order": 3,
    "disp": true,
    "width": "12"
  },
  {
    "id": "ui_tab_waste",
    "type": "ui_tab",
    "name": "Smart Waste",
    "icon": "fa-trash",
    "order": 1,
    "disabled": false,
    "hidden": false
  }
]